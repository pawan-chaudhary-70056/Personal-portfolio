# syntax=docker/dockerfile:1.7
# Single-container production image for the Render deployment (render.yaml).
#
# The API and the SPA are built into ONE container so the site and /api share
# a single origin: the session cookie is SameSite=Lax and therefore cannot be
# sent cross-origin, so the browser must reach both through the same host.
# In production the API serves the built SPA when ../frontend/dist exists
# (backend/src/app.ts), which is why the frontend lands at /app/frontend/dist
# relative to a WORKDIR of /app/backend.
#
# docker-compose.prod.yml keeps its two-container (nginx + API) setup and does
# not use this file. CI builds this image alongside the other two.

FROM node:24-alpine AS frontend-build
WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend ./
RUN npm run build

FROM node:24-alpine AS api-build
WORKDIR /app

# Prisma's query engine needs OpenSSL on Alpine.
RUN apk add --no-cache openssl

COPY backend/package.json backend/package-lock.json ./
RUN npm ci

COPY backend/prisma ./prisma
RUN npx prisma generate

COPY backend/tsconfig.json ./
COPY backend/src ./src
RUN npm run build

FROM node:24-alpine AS runtime
WORKDIR /app

RUN apk add --no-cache openssl

ENV NODE_ENV=production \
    PORT=4000 \
    MEDIA_ROOT=/app/backend/storage/media

COPY backend/package.json backend/package-lock.json ./
COPY --from=api-build /app/node_modules ./backend/node_modules
COPY --from=api-build /app/dist ./backend/dist
COPY --from=api-build /app/prisma ./backend/prisma
COPY --from=frontend-build /app/dist ./frontend/dist

# Uploaded files live here. On Render's free plan this filesystem is replaced
# on every deploy; a paid plan can attach a disk at MEDIA_ROOT (docs/12).
RUN mkdir -p /app/backend/storage/media && chown -R node:node /app
USER node

# app.ts resolves the SPA from ../frontend/dist relative to this directory.
WORKDIR /app/backend

EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=3 \
  CMD wget -q --tries=1 --spider "http://127.0.0.1:${PORT:-4000}/api/health" || exit 1

# render.yaml overrides this with `npx prisma migrate deploy && node
# dist/index.js` so migrations run once per deploy before the app starts.
CMD ["node", "dist/index.js"]
