# Runtime
NODE_ENV=development
PORT=4000

# Database (matches docker-compose.yml; change for staging/production)
DATABASE_URL=postgresql://portfolio:portfolio_dev_password@127.0.0.1:5433/portfolio_dev?schema=public

# Session signing secret. Generate with: openssl rand -hex 32
# Never commit the real value.
SESSION_SECRET=replace-with-a-32-byte-random-hex-string
SESSION_COOKIE_NAME=portfolio.sid

# Allowed browser origin for credentialed requests in development.
# In production the API is served from the same origin as the frontend.
FRONTEND_ORIGIN=http://localhost:5173

# Uploaded media. Relative paths resolve from the backend directory. The
# directory must be persistent in production and included in backups.
MEDIA_ROOT=storage/media
MEDIA_MAX_BYTES=8388608
MEDIA_UPLOAD_LIMIT_PER_HOUR=20

# Only enable behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# Failed sign-in attempts allowed per 15 minutes, per IP. Keep this small in
# production (5 is the default); raise it only for local automation.
LOGIN_RATE_LIMIT_MAX=5

# Used by `npm run create-admin` only. Not read by the API at runtime.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-this-to-a-long-unique-password
ADMIN_NAME=Portfolio Owner
